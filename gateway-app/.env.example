# Simple Fabric Network Gateway Application

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# Fabric Network Configuration
FABRIC_VERSION=2.5.0
CHANNEL_NAME=mychannel
CHAINCODE_NAME=asset

# Default Organization
DEFAULT_ORG=buyer
DEFAULT_USER=Admin
DEFAULT_MSP_ID=BuyerMSP

# Crypto Path
CRYPTO_PATH=../organizations/peerOrganizations

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# CORS
CORS_ORIGIN=*

# Gateway Timeouts (milliseconds)
EVALUATE_TIMEOUT=10000
ENDORSE_TIMEOUT=30000
SUBMIT_TIMEOUT=10000
COMMIT_STATUS_TIMEOUT=120000
